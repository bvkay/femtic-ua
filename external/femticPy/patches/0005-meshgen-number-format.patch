         for i in range(3):
-            file.write(' %4.1f %4.1f\n'%(self.analysis_domain[i][0], self.analysis_domain[i][1]))
+            file.write(' %.10g %.10g\n'%(self.analysis_domain[i][0], self.analysis_domain[i][1]))
         file.close() 
         
     
