         file.write('ALPHA_WEIGHT\n')
         for i in range(len(ALPHA_WEIGHT)):
-            file.write('%.2f '%ALPHA_WEIGHT[i]) 
+            file.write('%.10g '%ALPHA_WEIGHT[i]) 
         file.write('\n')
         file.write('INV_METHOD\n')
         file.write('%d\n'%INV_METHOD)
         file.write('BOTTOM_RESISTIVITY\n')
