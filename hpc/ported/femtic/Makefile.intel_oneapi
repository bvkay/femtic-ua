# ---------------------------------------------------------------------------
# FEMTIC v5.0 -- Makefile for Intel oneAPI 2023 (icpx + Intel MPI + MKL)
# Target: EasyBuild intel/2023a (intel-compilers 2023.1, impi 2021.9, imkl 2023.1)
#
#   module load intel/2023a                   # exports MKLROOT and I_MPI_ROOT
#   cd femtic/src
#   make -f Makefile.intel_oneapi -j 8
#
# Compiler wrapper:
#   mpiicpx           LLVM-based icpx. mpiicpx may or may not exist in impi 2021.9
#                     (intel/2023a); phoenix_plan/01_build_femtic.sh auto-detects it
#                     and falls back to "mpiicpc -cxx=icpx" via make CXX=...
#   mpiicpc           classic icpc on oneAPI <= 2023.  The classic compilers
#                     were removed in oneAPI 2024.  Use this with the upstream
#                     Makefile_IntelMPI flags if bit-for-bit parity with the
#                     original build matters.
#   mpiicpc -cxx=icpx (or I_MPI_CXX=icpx mpiicpc) drives icpx through the
#                     classic wrapper wherever mpiicpx is absent.
#
# Changes vs. the upstream Makefile_IntelMPI:
#   * The hard-coded INTEL_DIR (/opt/intel/composer_xe_2015...) is replaced
#     by $(MKLROOT) from the environment.
#   * -lmkl_blacs_intelmpi_ilp64 is dropped: no BLACS/ScaLAPACK symbol is used
#     anywhere in the sources (grep-verified).
#   * -L$(MKLROOT)/lib added next to lib/intel64 (imkl 2024+ layout).
#   * Pattern rule %.o: %.cpp so that "make -j N" works.
#
# One-flag alternative: with icpx/icpc the -I/-L/-l MKL lines below can be
# replaced by a single "-qmkl-ilp64=parallel" on both the compile and the link
# line.  It selects mkl_intel_ilp64 + mkl_intel_thread + mkl_core + iomp5 and
# adds the include path.  -DMKL_ILP64 is still required so that the headers
# declare MKL_INT as 64-bit.  (The classic "-mkl=..." spelling is icpc-only.)
#
# Floating point: icpx defaults to -fp-model=fast (as classic icpc did), GCC
# -O3 does not reassociate.  Add -fp-model=precise to CXXFLAGS if results must
# be comparable with the GCC build.  Never use -ffast-math/-Ofast.
#
# ILP64 is mandatory: see the note in Makefile.gcc_openmpi_mkl (pardiso_64,
# pardisoinit with long long*, MKL_INT in cblas/LAPACKE calls).
# ---------------------------------------------------------------------------

CXX           = mpiicpx
CC            = mpiicx

ifeq ($(filter clean,$(MAKECMDGOALS)),)
ifeq ($(strip $(MKLROOT)),)
$(error MKLROOT is not set. Load the oneAPI/MKL module (e.g. "module load intel/2023a") or source setvars.sh)
endif
endif

CXXFLAGS      = -O3 \
                -qopenmp \
                -D_LINUX \
                -DMKL_ILP64 \
                -D_USE_OMP \
                -DNDEBUG \
                -I$(MKLROOT)/include
DEST          = ./
LDFLAGS       =
LIBS          = -L$(MKLROOT)/lib/intel64 -L$(MKLROOT)/lib \
                -lmkl_intel_ilp64 -lmkl_intel_thread -lmkl_core \
                -liomp5 -lpthread -lm -ldl
OBJS          = AnalysisControl.o \
                ComplexSparseMatrix.o \
                ComplexSparseSquareMatrix.o \
                ComplexSparseSquareSymmetricMatrix.o \
                ComplexSparseSquareUnsymmetricMatrix.o \
                DoubleSparseMatrix.o \
                DoubleSparseSquareMatrix.o \
                DoubleSparseSquareSymmetricMatrix.o \
                DoubleSparseSquareUnsymmetricMatrix.o \
                Forward2D.o \
                Forward2DQuadrilateralElement.o \
                Forward2DNonConformingQuadrilateralElement0thOrderEdgeBased.o \
                Forward2DQuadrilateralElementEdgeBased.o \
                Forward2DSquareElement.o \
                Forward2DSquareElement0thOrderEdgeBased.o \
                Forward2DSquareElement1stOrderEdgeBased.o \
                Forward2DSquareElementEdgeBased.o \
                Forward2DTriangleElement.o \
                Forward2DTriangleElement0thOrderEdgeBased.o \
                Forward2DTriangleElementEdgeBased.o \
                Forward3D.o \
                Forward3DBrickElement0thOrder.o \
                Forward3DNonConformingHexaElement0thOrder.o \
                Forward3DNonConformingHexaElement0thOrderAnisotropic.o \
                Forward3DNonConformingHexaElement0thOrderIsotropic.o \
                Forward3DTetraElement0thOrder.o \
                Forward3DTetraElement0thOrderAnisotropic.o \
                Forward3DTetraElement0thOrderIsotropic.o \
                Inversion.o \
                InversionGaussNewtonModelSpace.o \
                InversionGaussNewtonDataSpaceIsotropic.o \
                InversionGaussNewtonDataSpaceAnisotropic.o \
                main.o \
                MeshData.o \
                MeshDataBrickElement.o \
                MeshDataNonConformingHexaElement.o \
                MeshDataTetraElement.o \
                AdditinalOutputPoint.o \
                ObservedDataStation.o \
                ObservedDataStationPoint.o \
                ObservedDataStationMT.o \
                ObservedDataStationApparentResistivityAndPhase.o \
                ObservedDataStationHTF.o \
                ObservedDataStationVTF.o \
                ObservedDataStationPT.o \
                ObservedDataStationNMT.o \
                ObservedDataStationNMT2.o \
                ObservedDataStationNMT2ApparentResistivityAndPhase.o \
                ObservedData.o \
                OutputFiles.o \
                PARDISOSolver.o \
                PARDISOSolverComplex.o \
                PARDISOSolverDouble.o \
                ResistivityBlock.o \
                ResistivityBlockIsotropic.o \
                ResistivityBlockAnisotropic.o \
                RougheningMatrix.o \
                RougheningSquareMatrix.o \
                Util.o
PROGRAM       = femtic

.PHONY: all clean

all:            $(PROGRAM)

$(PROGRAM):     $(OBJS)
	$(CXX) $(CXXFLAGS) $(OBJS) $(LDFLAGS) $(LIBS) -o $(PROGRAM)

# The upstream makefiles track no header dependencies; rebuild every object
# when any header changes (cheap for projects of this size, and always correct).
$(OBJS): $(wildcard *.h)

# Pattern rule so that "make -j N" compiles translation units in parallel.
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f *.o *~ $(PROGRAM)
